rules_version = '2';

// Una sola cuenta, sus propios datos y nada más.
//
// La configuración de Firebase es pública (viaja en la app), así que la
// seguridad no puede depender de que nadie la vea. Depende de esto:
//
//   - Sólo entra emmanuelclubdelmate@gmail.com, con el mail verificado.
//   - Sólo toca su propio árbol usuarios/{uid}.
//   - Todo lo demás queda denegado, sin excepción.
//
// Publicar:  firebase deploy --only firestore:rules
// O pegarlas en la consola: Firestore → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function esElDueno(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email == 'emmanuelclubdelmate@gmail.com'
          && request.auth.token.email_verified == true;
    }

    match /usuarios/{uid} {
      allow read, write: if esElDueno(uid);

      match /{documento=**} {
        allow read, write: if esElDueno(uid);
      }
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
